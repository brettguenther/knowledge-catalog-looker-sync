{% endif %}
# Last Synced: {{ sync_timestamp }}

view: {{ view.view_name }} {
  sql_table_name: {{ view.sql_table_name }} ;;
  fields_hidden_by_default: yes
{% for dim in view.dimensions %}

  dimension: {{ dim.name }} {
{% if dim.primary_key %}
    primary_key: yes
{% endif %}
    type: {{ dim.type }}
    sql: {{ dim.sql }} ;;
{% if not dim.hidden %}
    hidden: no
{% if dim.label %}
    label: "{{ dim.label }}"
{% endif %}
{% if dim.description %}
    description: "{{ dim.description }}"
{% endif %}
{% if dim.synonyms %}
    synonyms: [{% for s in dim.synonyms %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if dim.tags %}
    tags: [{% for t in dim.tags %}"{{ t }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if dim.suggestions %}
    suggestions: [{% for v in dim.suggestions %}"{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if dim.value_format_name %}
    value_format_name: {{ dim.value_format_name }}
{% endif %}
{% endif %}
  }
{% endfor %}
{% for m in view.measures %}

  measure: {{ m.name }} {
    type: {{ m.type }}
    sql: {{ m.sql }} ;;
{% if not m.hidden %}
    hidden: no
{% endif %}
{% if m.label %}
    label: "{{ m.label }}"
{% endif %}
{% if m.description %}
    description: "{{ m.description }}"
{% endif %}
{% if m.synonyms %}
    synonyms: [{% for s in m.synonyms %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if m.tags %}
    tags: [{% for t in m.tags %}"{{ t }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if m.value_format_name %}
    value_format_name: {{ m.value_format_name }}
{% endif %}
  }
{% endfor %}
}
